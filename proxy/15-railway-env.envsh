#!/bin/sh
# Sourced by the nginx entrypoint before envsubst renders /etc/nginx/templates.
# Railway's private DNS server comes from /etc/resolv.conf (IPv6 addresses need brackets).
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf)
  case "$NGINX_RESOLVER" in *:*) NGINX_RESOLVER="[$NGINX_RESOLVER]" ;; esac
fi
export NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"
export PORT="${PORT:-8080}"
export API_HOST="${API_HOST:-api.railway.internal}" API_PORT="${API_PORT:-5001}"
export WEB_HOST="${WEB_HOST:-web.railway.internal}" WEB_PORT="${WEB_PORT:-3000}"
export PLUGIN_DAEMON_HOST="${PLUGIN_DAEMON_HOST:-plugin-daemon.railway.internal}" PLUGIN_DAEMON_PORT="${PLUGIN_DAEMON_PORT:-5002}"
export NGINX_CLIENT_MAX_BODY_SIZE="${NGINX_CLIENT_MAX_BODY_SIZE:-100M}"
export NGINX_PROXY_TIMEOUT="${NGINX_PROXY_TIMEOUT:-3600s}"
# Only substitute our own variables, never nginx runtime variables such as $host.
export NGINX_ENVSUBST_FILTER='^(PORT|NGINX_RESOLVER|API_HOST|API_PORT|WEB_HOST|WEB_PORT|PLUGIN_DAEMON_HOST|PLUGIN_DAEMON_PORT|NGINX_CLIENT_MAX_BODY_SIZE|NGINX_PROXY_TIMEOUT)$'
echo "dify-proxy: listening on ${PORT}, resolver ${NGINX_RESOLVER}, api ${API_HOST}:${API_PORT}, web ${WEB_HOST}:${WEB_PORT}, plugin ${PLUGIN_DAEMON_HOST}:${PLUGIN_DAEMON_PORT}"
